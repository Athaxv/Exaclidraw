{
    "extends": "@repo/typescript-config/base.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "types": ["node"],
        "incremental": true,
        "baseUrl": ".",
        "paths": {
            "@repo/common/*": ["../../packages/common/src/*"],
            "@repo/backend-common/*": ["../../packages/backend-common/src/*"],
            "@repo/db/*": ["../../packages/db-package/src/*"]
        }
    },
    "include": ["src"],
  "references": [
    { "path": "../../packages/db-package" },
    { "path": "../../packages/backend-common" },
    { "path": "../../packages/common" }
  ]
}